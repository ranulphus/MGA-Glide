+/* MGA-Glide local patch: XZOOMCTRL hzoom 2x in MGA mode. hdisp stays the
+ * displayed width; each of the hdisp/2 memory pixels is shown twice. */
+static void
+mystique_render_zoom2(svga_t *svga, int bytes)
+{
+    uint32_t *p;
+    uint32_t  changed_addr;
+    int       x;
+
+    if (((svga->displine + svga->y_add) < 0) || (svga->monitor->target_buffer == NULL) ||
+        (svga->monitor->target_buffer->line[svga->displine + svga->y_add] == NULL))
+        return;
+    changed_addr = svga->remap_func(svga, svga->memaddr);
+    if (!(svga->changedvram[changed_addr >> 12] || svga->changedvram[(changed_addr >> 12) + 1] || svga->fullchange))
+        return;
+    p = &svga->monitor->target_buffer->line[svga->displine + svga->y_add][svga->x_add];
+    if (svga->firstline_draw == 2000)
+        svga->firstline_draw = svga->displine;
+    svga->lastline_draw = svga->displine;
+    for (x = 0; x < svga->hdisp; x += 2) {
+        uint32_t a = (svga->memaddr + (uint32_t) (x >> 1) * (uint32_t) bytes) & svga->vram_display_mask;
+        uint32_t c;
+        if (bytes == 4)
+            c = svga_lookup_lut_ram(svga, *(uint32_t *) &svga->vram[a] & 0xffffff);
+        else
+            c = svga->conv_16to32(svga, *(uint16_t *) &svga->vram[a], (svga->bpp == 15) ? 15 : 16);
+        p[x] = p[x + 1] = c;
+    }
+    svga->memaddr = (svga->memaddr + (uint32_t) (svga->hdisp >> 1) * (uint32_t) bytes) & svga->vram_display_mask;
+}
+
+static void
+mystique_render_16bpp_zoom2(svga_t *svga)
+{
+    mystique_render_zoom2(svga, 2);
+}
+
+static void
+mystique_render_32bpp_zoom2(svga_t *svga)
+{
+    mystique_render_zoom2(svga, 4);
+}
