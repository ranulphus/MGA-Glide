diff --git a/src/cpu/x86seg.c b/src/cpu/x86seg.c
index 8e60f0e..4ca13b8 100644
--- a/src/cpu/x86seg.c
+++ b/src/cpu/x86seg.c
@@ -1891,6 +1891,11 @@ pmodeiret(int is32)
         cpu_state.seg_cs.ar_high = 0x10;
         CS                       = seg;
         cpu_state.flags          = (cpu_state.flags & 0x3000) | (tempflags & 0xcfd5) | 2;
+        /* MGA-Glide 0114: IRETD in V86 mode (IOPL 3) loads RF, AC and ID as
+           the model has them; VM, VIF and VIP stay (SDM: IRET). */
+        if (is32)
+            cpu_state.eflags = (cpu_state.eflags & ~(RF_FLAG | AC_FLAG | VID_FLAG)) |
+                               ((tempflags >> 16) & (RF_FLAG | AC_FLAG | VID_FLAG) & cpu_eflags_hi_mask());
         cycles -= timing_iret_rm;
         return;
     }
@@ -1934,6 +1939,7 @@ pmodeiret(int is32)
     eflagmask = RF_FLAG | AC_FLAG | VID_FLAG;
     if (CPL == 0)
         eflagmask |= VIF_FLAG | VIP_FLAG;
+    eflagmask &= cpu_eflags_hi_mask(); /* MGA-Glide 0114: only the bits the model has */
     if (is32) {
         newpc     = POPL();
         seg       = POPL();
@@ -1953,7 +1959,7 @@ pmodeiret(int is32)
                 ESP = oldsp;
                 return;
             }
-            cpu_state.eflags = tempflags >> 16;
+            cpu_state.eflags = (tempflags >> 16) & cpu_eflags_hi_mask(); /* MGA-Glide 0114 */
             cpu_cur_status |= CPU_STATUS_V86;
             op_loadseg(segs[0], &cpu_state.seg_es);
             do_seg_v86_init(&cpu_state.seg_es);
@@ -2314,7 +2320,7 @@ taskswitch286(uint16_t seg, uint16_t *segdat, int is32)
 
         cpu_state.pc     = new_pc;
         cpu_state.flags  = new_flags;
-        cpu_state.eflags = new_flags >> 16;
+        cpu_state.eflags = (new_flags >> 16) & cpu_eflags_hi_mask(); /* MGA-Glide 0114 */
         cpu_386_flags_extract();
 
         ldt.seg   = new_ldt;
