MGA-Glide local patch 0114: IRETD loads only the EFLAGS[31:16] bits the CPU has.

POPFD masks the high word by CPU model (RF and VM; AC from the 486; ID with
CPUID; VIF and VIP with VME), and PUSHFD shows only those, but IRETD did not
mask: into V86 mode it loaded the whole word, and to the same or an outer
level it loaded RF, AC and ID on any CPU. So on a 486DX2 an IRETD with ID set
kept ID in EFLAGS, and the next exception frame showed it: a V86 monitor that
builds the FLAGS image from the frame (GLOS) let lDebugX see ID toggle, take
CPUID to be there and run it into #UD. cpu_eflags_hi_mask() gives the model's
bits; IRETD into V86 mode, to ring 0-3, in real mode and a task switch's
EFLAGS go through it (VM is in every mask, so V86 entry is unchanged). An
IRETD in V86 mode at IOPL 3 loaded none of the high word; it now loads RF, AC
and ID as the model has them (SDM: IRET), so a CPU with CPUID can set ID that
way too. V86TEST case X.

diff --git a/src/cpu/cpu.h b/src/cpu/cpu.h
index 23e7d51..f140e54 100644
--- a/src/cpu/cpu.h
+++ b/src/cpu/cpu.h
@@ -605,6 +605,22 @@ extern msr_t    msr;
 extern uint8_t  opcode;
 extern int      cpl_override;
 extern int      CPUID;
+
+/* MGA-Glide 0114: the EFLAGS[31:16] bits this CPU model has, as POPFD masks
+   them: RF and VM, AC from the 486, ID with CPUID, VIF and VIP with VME. Every
+   load of the high word (IRETD, a task switch) goes through it, so a CPU
+   without CPUID never shows ID set. */
+static inline uint16_t
+cpu_eflags_hi_mask(void)
+{
+    if (cpu_CR4_mask & CR4_VME)
+        return 0x3f;
+    if (CPUID)
+        return 0x27;
+    if (is486 || isibm486)
+        return 0x07;
+    return 0x03;
+}
 extern uint64_t xt_cpu_multi;
 extern int      isa_cycles;
 extern int      cpu_inited;
diff --git a/src/cpu/x86_ops_ret.h b/src/cpu/x86_ops_ret.h
index 8bf72e9..8a07a08 100644
--- a/src/cpu/x86_ops_ret.h
+++ b/src/cpu/x86_ops_ret.h
@@ -280,13 +280,13 @@ opIRETD(UNUSED(uint32_t fetchdat))
             cpu_state.pc     = readmeml(ss, ESP);
             new_cs           = readmemw(ss, ESP + 4);
             cpu_state.flags  = (readmemw(ss, ESP + 8) & 0xffd5) | 2;
-            cpu_state.eflags = readmemw(ss, ESP + 10);
+            cpu_state.eflags = readmemw(ss, ESP + 10) & cpu_eflags_hi_mask(); /* MGA-Glide 0114 */
             ESP += 12;
         } else {
             cpu_state.pc     = readmeml(ss, SP);
             new_cs           = readmemw(ss, ((SP + 4) & 0xffff));
             cpu_state.flags  = (readmemw(ss, (SP + 8) & 0xffff) & 0xffd5) | 2;
-            cpu_state.eflags = readmemw(ss, (SP + 10) & 0xffff);
+            cpu_state.eflags = readmemw(ss, (SP + 10) & 0xffff) & cpu_eflags_hi_mask(); /* MGA-Glide 0114 */
             SP += 12;
         }
         op_loadcs(new_cs);
