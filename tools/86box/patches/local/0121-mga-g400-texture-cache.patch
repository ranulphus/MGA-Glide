+/* MGA-Glide local patch: the G400's texture cache, as a model: lines of
+ * texture memory, direct-mapped. What the silicon showed (bench-g400,
+ * 2026-10-26, DOS-GL's G4EXP E6) is that it keeps texels across writes to
+ * texture memory, by the engine or the CPU, and that rewriting the texture
+ * registers empties it. The silicon's cache is smaller (about an eighth of
+ * E6's 8 KB texture came back stale); this one holds 32 KB, so that a
+ * texture written in place and drawn without a TEXORG write reads stale
+ * texels every time, and Loop A shows the missing flush. */
+#define MGA_TCACHE_LINES 1024
+#define MGA_TCACHE_LINE  32
 #define MGA_BUS_FIFO(m) ((m)->type <= MGA_1064SG ? 32 : (m)->type >= MGA_G400 ? 16 : 64)
 
