+/* The bytes of texture memory at addr (already masked) as the G400's
+ * texture cache holds them: a missing line is filled from VRAM, and a line
+ * stays until another maps to its slot or TEXORG is written. Other chips
+ * read VRAM directly. */
+static inline const uint8_t *
+tcache_at(mystique_t *mystique, uint32_t addr)
+{
+    uint32_t line;
+    int      i;
+    if (mystique->type < MGA_G400)
+        return &mystique->svga.vram[addr];
+    line = addr & ~(uint32_t) (MGA_TCACHE_LINE - 1);
+    i    = (int) (line / MGA_TCACHE_LINE) & (MGA_TCACHE_LINES - 1);
+    if (mystique->tcache_tag[i] != line) {
+        memcpy(mystique->tcache_data[i], &mystique->svga.vram[line], MGA_TCACHE_LINE);
+        mystique->tcache_tag[i] = line;
+    }
+    return &mystique->tcache_data[i][addr - line];
+}
+
+static inline void
+tcache_flush(mystique_t *mystique)
+{
+    memset(mystique->tcache_tag, 0xff, sizeof mystique->tcache_tag);
+}
