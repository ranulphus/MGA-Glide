+/* MGA-Glide local patch 0009 (G400 dual texturing). The texture registers
+ * exist once per texture map; dwgreg holds map 0. While tmap0dis is 0 a
+ * write goes to both maps, while it is 1 to map 1 only. tmap0dis is the OR
+ * of the map1 bit (31) last written to TEXCTL2, TEXWIDTH and TEXHEIGHT and
+ * "is effective on the next access" (G400 specification p.3-216), so the
+ * write that sets it still reaches both maps. A register written through
+ * its start alias (+0x100) starts the draw only after the routing. */
+static uint32_t *
+g400_map_reg(mystique_t *mystique, uint32_t reg, int map)
+{
+    if (reg >= REG_TMR0 && reg <= REG_TMR0 + 32)
+        return map ? &mystique->map1.tmr[(reg - REG_TMR0) >> 2] : &mystique->dwgreg.tmr[(reg - REG_TMR0) >> 2];
+    if (reg >= REG_TEXORG1 && reg <= REG_TEXORG1 + 12)
+        return map ? &mystique->map1.texorgn[(reg - REG_TEXORG1) >> 2] : &mystique->dwgreg.texorgn[(reg - REG_TEXORG1) >> 2];
+    switch (reg) {
+        case REG_TEXORG:       return map ? &mystique->map1.texorg : &mystique->dwgreg.texorg;
+        case REG_TEXWIDTH:     return map ? &mystique->map1.texwidth : &mystique->dwgreg.texwidth;
+        case REG_TEXHEIGHT:    return map ? &mystique->map1.texheight : &mystique->dwgreg.texheight;
+        case REG_TEXCTL:       return map ? &mystique->map1.texctl : &mystique->dwgreg.texctl;
+        case REG_TEXTRANS:     return map ? &mystique->map1.textrans : &mystique->dwgreg.textrans;
+        case REG_TEXTRANSHIGH: return map ? &mystique->map1.textranshigh : &mystique->dwgreg.textranshigh;
+        case REG_TEXCTL2:      return map ? &mystique->map1.texctl2 : &mystique->dwgreg.texctl2;
+        case REG_TEXFILTER:    return map ? &mystique->map1.texfilter : &mystique->dwgreg.texfilter;
+        case REG_TEXBORDERCOL: return map ? &mystique->map1.texbordercol : &mystique->dwgreg.texbordercol;
+        case REG_ALPHACTRL:    return map ? &mystique->map1.alphactrl : &mystique->dwgreg.alphactrl;
+        default:               return NULL;
+    }
+}
+
+static void
+g400_texreg_write(mystique_t *mystique, uint32_t addr, uint32_t val, int bytes, void *priv)
+{
+    const int      exec = (addr & 0x300) == 0x100;
+    const uint32_t a    = exec ? (addr & ~0x100) : addr;
+    const uint32_t reg  = a & 0x3ffc;
+    const uint32_t mask = bytes == 4 ? 0xffffffffu : (0xffu << (8 * (a & 3)));
+    uint32_t      *p0 = g400_map_reg(mystique, reg, 0), *p1 = g400_map_reg(mystique, reg, 1);
+    const uint32_t save = *p0;
+    const int      map1_only = mystique->map1_tc2 | mystique->map1_tw | mystique->map1_th;
+
+    if (bytes == 4)
+        mystique_accel_ctrl_write_l_raw(a, val, priv);
+    else
+        mystique_accel_ctrl_write_b_raw(a, (uint8_t) val, priv);
+    *p1 = (*p1 & ~mask) | (*p0 & mask);
+    if (map1_only) {
+        *p0 = save;
+        mystique->dwgreg.ta_key  = (mystique->dwgreg.texctl & TEXCTL_TAKEY) ? 1 : 0;
+        mystique->dwgreg.ta_mask = (mystique->dwgreg.texctl & TEXCTL_TAMASK) ? 1 : 0;
+    }
+    if (bytes == 4 || (a & 3) == 3) {
+        const int bit = bytes == 4 ? (int) (val >> 31) : (int) ((val >> 7) & 1);
+        if (reg == REG_TEXCTL2)
+            mystique->map1_tc2 = bit;
+        else if (reg == REG_TEXWIDTH)
+            mystique->map1_tw = bit;
+        else if (reg == REG_TEXHEIGHT)
+            mystique->map1_th = bit;
+    }
+    if (exec)
+        mystique_start_blit(mystique);
+}
+
+static int
+g400_routes(mystique_t *mystique, uint32_t addr)
+{
+    const uint32_t a = ((addr & 0x300) == 0x100) ? (addr & ~0x100) : addr;
+    return mystique->type >= MGA_G400 && g400_map_reg(mystique, a & 0x3ffc, 0) != NULL;
+}
+
+static void
+mystique_accel_ctrl_write_b(uint32_t addr, uint8_t val, void *priv)
+{
+    mystique_t *mystique = (mystique_t *) priv;
+
+    if (g400_routes(mystique, addr))
+        g400_texreg_write(mystique, addr, val, 1, priv);
+    else
+        mystique_accel_ctrl_write_b_raw(addr, val, priv);
+}
+
+static void
+mystique_accel_ctrl_write_l(uint32_t addr, uint32_t val, void *priv)
+{
+    mystique_t *mystique = (mystique_t *) priv;
+
+    if (g400_routes(mystique, addr))
+        g400_texreg_write(mystique, addr, val, 4, priv);
+    else
+        mystique_accel_ctrl_write_l_raw(addr, val, priv);
+}
