+/* MGA-Glide local patch 0009 (G400 dual texturing). Exchange map 1's
+ * registers with dwgreg (map 0), so texture_read samples map 1. */
+static void
+g400_swap_map1(mystique_t *mystique)
+{
+#define G400_SWAP(f)                                 \
+    do {                                             \
+        uint32_t t_          = mystique->dwgreg.f;   \
+        mystique->dwgreg.f   = mystique->map1.f;     \
+        mystique->map1.f     = t_;                   \
+    } while (0)
+    for (int i = 0; i < 9; i++)
+        G400_SWAP(tmr[i]);
+    for (int i = 0; i < 4; i++)
+        G400_SWAP(texorgn[i]);
+    G400_SWAP(texorg);
+    G400_SWAP(texwidth);
+    G400_SWAP(texheight);
+    G400_SWAP(texctl);
+    G400_SWAP(texctl2);
+    G400_SWAP(textrans);
+    G400_SWAP(textranshigh);
+    G400_SWAP(texfilter);
+    G400_SWAP(texbordercol);
+    G400_SWAP(alphactrl);
+#undef G400_SWAP
+    mystique->dwgreg.ta_key  = (mystique->dwgreg.texctl & TEXCTL_TAKEY) ? 1 : 0;
+    mystique->dwgreg.ta_mask = (mystique->dwgreg.texctl & TEXCTL_TAMASK) ? 1 : 0;
+}
+
+static int
+g400_sat(int v)
+{
+    return v < 0 ? 0 : v > 255 ? 255 : v;
+}
+
+/* One TDUALSTAGE stage (G400 specification p.3-196..3-203, figures 3-1 and
+ * 3-2). cur: this stage's texel; prev: the previous stage (in stage 0,
+ * texture 1); prevtex: the other texture (in stage 0 the bump-map
+ * luminance, not modelled: 0); dif, spc, fc: diffuse, specular, FCOL. All
+ * RGBA 0..255. Products are (a * b) >> 8, the legacy modulate's arithmetic,
+ * so a modulating word reproduces TEXCTL.tmodulate exactly; the silicon's
+ * rounding is not known. The blend bit runs two passes: the first product
+ * is kept (TMP) and the second uses the inverted multiplier selects. */
+static void
+g400_stage(uint32_t td, const int cur[4], const int prev[4], const int prevtex[4], const int dif[4],
+           const int spc[4], const int fc[4], int out[4])
+{
+    const int *const arg2src[4] = { dif, spc, fc, prev };
+    const int *const a2 = arg2src[td & 3];
+    const int  asrc[5]  = { dif[3], fc[3], cur[3], prevtex[3], prev[3] };
+    const int  as       = asrc[((td >> 2) & 7) > 4 ? 4 : (td >> 2) & 7];
+    const int  al1      = (td & (1u << 9)) ? 255 - as : as;
+    const int  al2      = (td & (1u << 10)) ? 255 - as : as;
+    const int  mb       = (td >> 15) & 3;
+    const int  aarg2[4] = { dif[3], fc[3], prevtex[3], prev[3] };
+    int        aa1, aa2;
+
+    for (int c = 0; c < 3; c++) {
+        int arg1 = (td & (1u << 5)) ? cur[3] : cur[c];
+        int arg2 = (td & (1u << 7)) ? a2[3] : a2[c];
+        int m1, m2, mul, in1, in2, add;
+        if (td & (1u << 6))
+            arg1 = 255 - arg1;
+        if (td & (1u << 8))
+            arg2 = 255 - arg2;
+        m1  = (td & (1u << 11)) ? al1 : arg1;
+        m2  = (td & (1u << 12)) ? al2 : arg2;
+        mul = g400_sat(((m1 * m2) >> 8) << mb);
+        if (td & (1u << 20)) {
+            const int tmp = mul;
+            m1  = (td & (1u << 11)) ? arg1 : al1;
+            m2  = (td & (1u << 12)) ? arg2 : al2;
+            mul = g400_sat(((m1 * m2) >> 8) << mb);
+            in1 = (td & (1u << 13)) ? mul : arg1;
+            in2 = (td & (1u << 14)) ? tmp : arg2;
+        } else {
+            in1 = (td & (1u << 13)) ? mul : arg1;
+            in2 = (td & (1u << 14)) ? mul : arg2;
+        }
+        add = (td & (1u << 17)) ? in1 + in2 : in1 - in2;
+        if (td & (1u << 19))
+            add -= 128;
+        if (td & (1u << 18))
+            add *= 2;
+        switch ((td >> 21) & 3) {
+            case 0: out[c] = arg1; break;
+            case 1: out[c] = arg2; break;
+            case 2: out[c] = g400_sat(add); break;
+            default: out[c] = mul; break;
+        }
+    }
+    aa1 = (td & (1u << 23)) ? 255 - cur[3] : cur[3];
+    aa2 = aarg2[(td >> 24) & 3];
+    if (td & (1u << 26))
+        aa2 = 255 - aa2;
+    switch ((td >> 30) & 3) {
+        case 0: out[3] = aa1; break;
+        case 1: out[3] = aa2; break;
+        case 2: {
+            int add = (td & (1u << 27)) ? aa1 + aa2 : aa1 - aa2;
+            if (td & (1u << 28))
+                add -= 128;
+            if (td & (1u << 29))
+                add *= 2;
+            out[3] = g400_sat(add);
+            break;
+        }
+        default:
+            out[3] = g400_sat(((aa1 * aa2) >> 8) << ((td >> 28) & 3));
+            break;
+    }
+}
