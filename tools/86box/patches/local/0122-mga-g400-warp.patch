+static void
+warp_input(mystique_t *mystique, uint32_t val)
+{
+    const int    size = (int) (mystique->warp.wvrtxsz & 0x3f) + 1;
+    mgawarp_regs r;
+
+    if (!mystique->warp.running)
+        return;
+    mystique->warp.v[mystique->warp.vn][mystique->warp.vdw++] = val;
+    if (mystique->warp.vdw < size)
+        return;
+    mystique->warp.vdw = 0;
+    if (++mystique->warp.vn < 3)
+        return;
+    mystique->warp.vn = 0;
+    r.pipe       = mystique->warp.pipe;
+    r.dwgctl     = mystique->dwgreg.dwgctrl;
+    r.maccess    = mystique->maccess;
+    r.wflag      = mystique->warp.wflag;
+    r.texctl     = mystique->dwgreg.texctl;
+    r.texwidth   = mystique->dwgreg.texwidth;
+    r.texheight  = mystique->dwgreg.texheight;
+    r.texctl1    = mystique->map1.texctl;
+    r.texwidth1  = mystique->map1.texwidth;
+    r.texheight1 = mystique->map1.texheight;
+    r.texctl2_1  = mystique->map1.texctl2;
+    mgawarp_triangle(mystique->warp.v[0], mystique->warp.v[1], mystique->warp.v[2], &r, warp_wr, mystique);
