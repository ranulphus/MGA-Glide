+/*
+ * MGA-Glide local patch: the Matrox G400's WARP setup engine, at a high
+ * level. The real WARP runs Matrox's microcode (Linux's linux-firmware
+ * matrox/g400_warp.fw, MIT, Copyright 1999 Matrox Graphics Inc.), whose
+ * instruction set is not public. This recognises a pipe by its microcode
+ * and does the pipe's setup with MGA-Glide's own triangle setup
+ * (mgahal/trap.c, MIT, Copyright 2026 The Nulph; see mgahal/LICENSE): on
+ * a real G400 the WARP's Gouraud triangles matched that setup's but for
+ * 60 of 20,045 pixels, all on edges (MGA-Glide's WARPTRI, 2026-10-26).
+ *
+ * The vertices are Mesa's mga driver's: x and y in pixels with its
+ * subpixel offset (-0.5, -0.375) already added, z from 0 to 1, 1/w, the
+ * colour as BGRA bytes, the specular colour as BGR bytes with the fog
+ * factor in the fourth, and u, v (and u1, v1) not divided by w.
+ */
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+
+#define MGA_HOST 1
+#define mga                 mgawarp_chip
+#define mga_fifo_free       mgawarp_fifo_free
+#define fifo_reserve        mgawarp_fifo_reserve
+#define setup_valid         mgawarp_setup_valid
+#define mga_host_wr32       mgawarp_host_wr32
+#define mga_host_rd32       mgawarp_host_rd32
+#define setup_triangle      mgawarp_setup_triangle
+#define setup_stats         mgawarp_setup_stats
+#define setup_edge          mgawarp_setup_edge
+#define setup_edge_voodoo   mgawarp_setup_edge_voodoo
+#include "mgahal/trap.c"
+
+#include <86box/vid_mga_warp.h>
+
+mga_chip mgawarp_chip;
+int      mgawarp_fifo_free;
+unsigned mgawarp_setup_valid;
+
+void
+mgawarp_fifo_reserve(int n)
+{
+    (void) n;
+    mgawarp_fifo_free = 1 << 20;
+}
+
+static void (*warp_wr)(void *p, uint32_t reg, uint32_t val);
+static void *warp_p;
+
+void
+mgawarp_host_wr32(uint32_t off, uint32_t v)
+{
+    warp_wr(warp_p, off, v);
+}
+
+uint32_t
+mgawarp_host_rd32(uint32_t off)
+{
+    (void) off;
+    return 0;
+}
+
+/* The G400's sixteen pipes: their length and CRC-32 in g400_warp.fw. */
+static const struct {
+    int      len;
+    uint32_t crc;
+    int      pipe;
+} g400_pipes[] = {
+    { 824, 0x562d7749u, 0x0 },  /* TGZ */
+    { 864, 0x70a8d576u, 0x1 },  /* TGZF */
+    { 856, 0xf17b4107u, 0x2 },  /* TGZA */
+    { 896, 0xee7c6df6u, 0x3 },  /* TGZAF */
+    { 928, 0x98b4051eu, 0x4 },  /* TGZS */
+    { 968, 0xc4970b8bu, 0x5 },  /* TGZSF */
+    { 968, 0x689c288eu, 0x6 },  /* TGZSA */
+    { 1000, 0x1c5f711cu, 0x7 }, /* TGZSAF */
+    { 1080, 0x990594fcu, 0x8 }, /* T2GZ */
+    { 1120, 0xe899d2eeu, 0x9 }, /* T2GZF */
+    { 1112, 0xf27b36d9u, 0xa }, /* T2GZA */
+    { 1152, 0xb9058c51u, 0xb }, /* T2GZAF */
+    { 1184, 0x2196c683u, 0xc }, /* T2GZS */
+    { 1224, 0x47c49bb6u, 0xd }, /* T2GZSF */
+    { 1224, 0x386f0027u, 0xe }, /* T2GZSA */
+    { 1256, 0x68534fffu, 0xf }, /* T2GZSAF */
+};
+
+static uint32_t
+crc32_of(const uint8_t *p, int n)
+{
+    uint32_t c = 0xffffffffu;
+    int      i, k;
+    for (i = 0; i < n; i++) {
+        c ^= p[i];
+        for (k = 0; k < 8; k++)
+            c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1)));
+    }
+    return ~c;
+}
+
+int
+mgawarp_pipe_of(const uint8_t *code, int len)
+{
+    int i;
+    for (i = 0; i < (int) (sizeof g400_pipes / sizeof g400_pipes[0]); i++)
+        if (g400_pipes[i].len <= len && crc32_of(code, g400_pipes[i].len) == g400_pipes[i].crc)
+            return g400_pipes[i].pipe;
+    return -1;
+}
+
+static float
+f32(uint32_t u)
+{
+    float f;
+    memcpy(&f, &u, sizeof f);
+    return f;
+}
+
+static void
+vertex(const uint32_t *d, int t2, double zmax, mga_svtx *v)
+{
+    const float rhw = f32(d[3]);
+    memset(v, 0, sizeof *v);
+    v->X16 = (int32_t) lrint((f32(d[0]) + 0.5) * 16.0);
+    v->Y16 = (int32_t) lrint((f32(d[1]) + 0.375) * 16.0);
+    v->z   = (double) f32(d[2]) * zmax;
+    v->b   = (float) (d[4] & 0xff);
+    v->g   = (float) ((d[4] >> 8) & 0xff);
+    v->r   = (float) ((d[4] >> 16) & 0xff);
+    v->a   = (float) (d[4] >> 24);
+    v->sb  = (float) (d[5] & 0xff);
+    v->sg  = (float) ((d[5] >> 8) & 0xff);
+    v->sr  = (float) ((d[5] >> 16) & 0xff);
+    v->fog = (float) (d[5] >> 24);
+    v->q   = rhw;
+    v->s   = f32(d[6]) * rhw;
+    v->t   = f32(d[7]) * rhw;
+    if (t2) {
+        v->s1 = f32(d[8]) * rhw;
+        v->t1 = f32(d[9]) * rhw;
+    }
+}
+
+/* In wrap mode, whole texture periods off each axis so the smallest
+ * coordinate lies in [0, 1), as the HAL's tex_adjust_coords does (the G400
+ * samples at texel centres: no half-texel shift). */
+static void
+wrap_shift(mga_svtx *v, int map1, int clamp_u, int clamp_v)
+{
+    int axis, i;
+    for (axis = 0; axis < 2; axis++) {
+        double mn = 1e30, shift;
+        if (axis ? clamp_v : clamp_u)
+            continue;
+        for (i = 0; i < 3; i++) {
+            double q = v[i].q > 0 ? v[i].q : 1e-9;
+            double u = (axis ? (map1 ? v[i].t1 : v[i].t) : (map1 ? v[i].s1 : v[i].s)) / q;
+            if (u < mn)
+                mn = u;
+        }
+        shift = -floor(mn);
+        for (i = 0; i < 3; i++) {
+            float *p = axis ? (map1 ? &v[i].t1 : &v[i].t) : (map1 ? &v[i].s1 : &v[i].s);
+            *p += (float) (shift * v[i].q);
+        }
+    }
+}
+
+/* A map's size from TEXWIDTH/TEXHEIGHT's mask field (<28:18>): the tw
+ * field holds log2 + 11 under the WARP (Mesa's values) but log2 under
+ * MGA-Glide's own setup, and the mask is the same under both. */
+static int
+log2_of_mask(uint32_t wh)
+{
+    uint32_t n = ((wh >> 18) & 0x7ff) + 1;
+    int      lg = 0;
+    while ((1u << lg) < n && lg < 11)
+        lg++;
+    return lg;
+}
+
+void
+mgawarp_triangle(const uint32_t *d0, const uint32_t *d1, const uint32_t *d2, const mgawarp_regs *r,
+                 void (*wr)(void *p, uint32_t reg, uint32_t val), void *p)
+{
+    const int    t2       = !!(r->pipe & MGAWARP_T2);
+    const int    textured = (r->dwgctl & 0xf) == DWG_OPCOD_TEXTURE_TRAP;
+    const int    atype    = (int) ((r->dwgctl >> 4) & 7);
+    const int    zmode    = (int) ((r->dwgctl >> 8) & 7);
+    const double zmax     = (r->maccess & MACCESS_ZW32) ? 4294967295.0 : 65535.0;
+    mga_svtx     v[3];
+    mga_tri_ctx  ctx;
+
+    vertex(d0, t2, zmax, &v[0]);
+    vertex(d1, t2, zmax, &v[1]);
+    vertex(d2, t2, zmax, &v[2]);
+
+    memset(&mgawarp_chip, 0, sizeof mgawarp_chip);
+    mgawarp_chip.family       = MGA_FAMILY_G400;
+    mgawarp_chip.fifo_depth   = 16;
+    mgawarp_chip.fifo_mask    = 0x1f;
+    mgawarp_chip.ar_bits      = 22;
+    mgawarp_chip.has_dwgsync  = 1;
+    mgawarp_chip.has_dstorg   = 1;
+    mgawarp_chip.has_texctl2  = 1;
+    mgawarp_chip.has_alpha_blend = 1;
+    mgawarp_chip.has_alpha_test  = 1;
+    mgawarp_chip.has_specular = 1;
+    mgawarp_chip.has_dual_tex = 1;
+    mgawarp_chip.texel_centre = 1;
+    mgawarp_setup_valid       = 0;      /* the host may have written any register since: write them all */
+
+    memset(&ctx, 0, sizeof ctx);
+    ctx.dwgctl  = r->dwgctl;
+    ctx.flags   = MGA_S_COLOR;
+    if (atype == 3 || zmode != 0)       /* ZI, or a depth test */
+        ctx.flags |= MGA_S_Z | ((r->maccess & MACCESS_ZW32) ? MGA_S_Z32 : 0);
+    if (r->pipe & MGAWARP_A)
+        ctx.flags |= MGA_S_ALPHA;
+    if (r->pipe & MGAWARP_F)
+        ctx.flags |= MGA_S_FOG;
+    if (r->pipe & MGAWARP_S)
+        ctx.flags |= MGA_S_SPEC;
+    ctx.clip_y0 = 0;
+    ctx.clip_y1 = 4096;
+    if (textured) {
+        ctx.flags |= MGA_S_TEX;
+        ctx.tex_tw = log2_of_mask(r->texwidth);
+        ctx.tex_th = log2_of_mask(r->texheight);
+        wrap_shift(v, 0, !!(r->texctl & TEXCTL_CLAMPU), !!(r->texctl & TEXCTL_CLAMPV));
+        if (t2) {
+            ctx.flags |= MGA_S_TEX2;
+            ctx.tex_tw1   = log2_of_mask(r->texwidth1);
+            ctx.tex_th1   = log2_of_mask(r->texheight1);
+            ctx.texctl2_1 = r->texctl2_1 | TEXCTL2_DUALTEX;
+            wrap_shift(v, 1, !!(r->texctl1 & TEXCTL_CLAMPU), !!(r->texctl1 & TEXCTL_CLAMPV));
+        }
+    }
+    warp_wr = wr;
+    warp_p  = p;
+    mgawarp_setup_triangle(&v[0], &v[1], &v[2], &ctx);
+}
