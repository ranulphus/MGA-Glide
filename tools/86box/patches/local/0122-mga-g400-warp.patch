+{
+    mystique_t *mystique = (mystique_t *) p;
+    if (MGA_EXEC_ADDR(mystique, reg))
+        mystique->blitter_submit_dma_refcount++;    /* (counted as DMA's are, or the engine reads busy) */
+    mystique_accel_ctrl_write_l(reg, val, p);
+}
