+#define MGAREG_DR10         0x1CE8
+#define MGAREG_DR11         0x1CEC
+#define MGAREG_DR12         0x1CF0
+#define MGAREG_FOGCOL       0x1CF4
+#define MGAREG_DR14         0x1CF8
+#define MGAREG_DR15         0x1CFC
