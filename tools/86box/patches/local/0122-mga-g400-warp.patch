+/* MGA-Glide local patch: the WARP setup engine (G400). Started (or
+ * jumped to) at an address, it runs the pipe whose microcode is there: in
+ * its instruction memory (WMISC.wucodecache = 0) or in memory, fetched by
+ * bus mastering. Vertices reach it through the DMA window or a DMA channel
+ * in vertex mode; every three make a triangle, set up by vid_mga_warp.c
+ * and drawn by the engine as the trapezoids it writes. */
+static void
+warp_start(mystique_t *mystique, uint32_t wiaddr)
+{
+    static uint8_t code[2048];
+    const uint32_t a = wiaddr & ~7u;
+    int            i;
+
+    switch (wiaddr & 3) {
+        case 0:         /* suspend */
+            mystique->warp.running = 0;
+            return;
+        case 1:         /* resume */
+            mystique->warp.running = mystique->warp.pipe >= 0;
+            return;
+        default:        /* jump, start */
+            if (!(mystique->warp.wmisc & 1)) {
+                const int off = (int) (a & 0x7ff);
+                mystique->warp.pipe = mgawarp_pipe_of(mystique->warp.imem[0] + off, 2048 - off);
+            } else {
+                for (i = 0; i < 2048; i++)
+                    code[i] = mem_readb_phys(a + (uint32_t) i);
+                mystique->warp.pipe = mgawarp_pipe_of(code, 2048);
+            }
+            if (mystique->warp.pipe < 0)
+                pclog("MGA-Glide: WARP started on microcode it does not know (%08x)\n", a);
+            mystique->warp.running = mystique->warp.pipe >= 0;
+            mystique->warp.vdw = mystique->warp.vn = 0;
+            break;
+    }
+}
