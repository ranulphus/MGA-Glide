+/* MGA-Glide local patch: the G400's WARP setup engine, at a high level
+ * (src/video/vid_mga_warp.c). */
+#ifndef VIDEO_MGA_WARP_H
+#define VIDEO_MGA_WARP_H
+#include <stdint.h>
+
+/* Pipe flags, as Linux's mga_drm.h numbers the G400's pipes. */
+#define MGAWARP_F  0x1  /* fog */
+#define MGAWARP_A  0x2  /* alpha */
+#define MGAWARP_S  0x4  /* specular */
+#define MGAWARP_T2 0x8  /* two textures */
+
+/* The pipe whose microcode starts at code (at most len bytes), or -1. */
+int mgawarp_pipe_of(const uint8_t *code, int len);
+
+/* What a triangle's setup needs of the chip's registers. */
+typedef struct {
+    int      pipe;                  /* MGAWARP_* */
+    uint32_t dwgctl, maccess, wflag;
+    uint32_t texctl, texwidth, texheight;       /* map 0 */
+    uint32_t texctl1, texwidth1, texheight1, texctl2_1;   /* map 1 (T2 pipes) */
+} mgawarp_regs;
+
+/* One triangle from three vertices as the WARP takes them (Mesa's mga
+ * vertex: x, y, z, 1/w, BGRA, specular BGR with fog, u0, v0 [, u1, v1]):
+ * the trapezoid registers it would write, through wr. */
+void mgawarp_triangle(const uint32_t *v0, const uint32_t *v1, const uint32_t *v2, const mgawarp_regs *r,
+                      void (*wr)(void *p, uint32_t reg, uint32_t val), void *p);
+
+#endif
