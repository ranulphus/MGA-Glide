+#define MGAREG_YDSTORG      0x1C94
+#define MGAREG_YTOP         0x1C98
+#define MGAREG_YBOT         0x1C9C
+#define MGAREG_CXLEFT       0x1CA0
+#define MGAREG_CXRIGHT      0x1CA4
+#define MGAREG_FXLEFT       0x1CA8
+#define MGAREG_FXRIGHT      0x1CAC
