+/* The index register an I/O port uses. Chipsets with several address pairs
+   have one index per pair, except the PIIX4: it decodes 74h-77h as aliases of
+   70h-73h, so 74h and 70h share the lower bank's index and 76h and 72h the
+   upper's (and 74h reads back what 70h set). SMM handlers depend on it: the
+   Award BIOS of the Abit BF6 traps port 71h and, in its handler, reads the
+   index at 74h and accesses the RTC through 74h/75h; with a separate index
+   there, its emulated reads of 71h all returned register 32h (the century)
+   once a change of year had moved that index. */
+static uint8_t
+nvr_addr_id(const local_t *local, uint16_t addr)
+{
+    if (local->flags & FLAG_PIIX4)
+        return (addr & 0x02) >> 1;
+    return (addr & 0x0e) >> 1;
+}
