+/* MGA-Glide local (GLOS D38): the same cards on the PCI bus, for machines
+   without an AGP slot (the 486 profiles). Matrox sold the G200 and the G450
+   as PCI cards; the G400 PCI is for completeness. The PCI configuration space
+   has no AGP capability (is_agp clear). The G200 says 0520h and has its own
+   BIOS, 899-33 (the AGP one, 900-33, doesn't know 0520h: it reports 2 MB and
+   no framebuffer address); the G400 and G450 keep theirs. */
+const device_t millennium_g200_pci_device = {
+    .name          = "Matrox Millennium G200 PCI (MGA-Glide emulation)",
+    .internal_name = "millennium_g200_pci",
+    .flags         = DEVICE_PCI,
+    .local         = MGA_G200,
+    .init          = mystique_init,
+    .close         = mystique_close,
+    .reset         = NULL,
+    .available     = matrox_g200_pci_available,
+    .speed_changed = mystique_speed_changed,
+    .force_redraw  = mystique_force_redraw,
+    .config        = g100_config
+};
+
+const device_t millennium_g400_pci_device = {
+    .name          = "Matrox Millennium G400 PCI (MGA-Glide emulation)",
+    .internal_name = "millennium_g400_pci",
+    .flags         = DEVICE_PCI,
+    .local         = MGA_G400,
+    .init          = mystique_init,
+    .close         = mystique_close,
+    .reset         = NULL,
+    .available     = matrox_g400_available,
+    .speed_changed = mystique_speed_changed,
+    .force_redraw  = mystique_force_redraw,
+    .config        = g400_config
+};
+
+const device_t millennium_g450_pci_device = {
+    .name          = "Matrox Millennium G450 PCI (MGA-Glide emulation)",
+    .internal_name = "millennium_g450_pci",
+    .flags         = DEVICE_PCI,
+    .local         = MGA_G450,
+    .init          = mystique_init,
+    .close         = mystique_close,
+    .reset         = NULL,
+    .available     = matrox_g450_available,
+    .speed_changed = mystique_speed_changed,
+    .force_redraw  = mystique_force_redraw,
+    .config        = g400_config
+};
