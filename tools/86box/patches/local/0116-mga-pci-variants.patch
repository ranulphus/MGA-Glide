+++ b/src/include/86box/video.h
@@ -517,6 +517,9 @@ extern const device_t productiva_g100_device;
 extern const device_t millennium_g200_device;
 extern const device_t millennium_g400_device;
 extern const device_t millennium_g450_device;
+extern const device_t millennium_g200_pci_device;      /* MGA-Glide local: PCI versions (GLOS D38) */
+extern const device_t millennium_g400_pci_device;
+extern const device_t millennium_g450_pci_device;
 #endif /* USE_G100 */
 
 /* JEGA */
diff --git a/src/video/vid_mga.c b/src/video/vid_mga.c
index 0a44d5d..7fef433 100644
--- a/src/video/vid_mga.c
+++ b/src/video/vid_mga.c
@@ -77,6 +77,9 @@ mystique_unsupported(const char *fmt, ...)
 #define ROM_G200              "roms/video/matrox/mgaglide/900-33.bin"
 /* MGA-Glide local: Matrox's G400 AGP BIOS 897-21, from the same package. */
 #define ROM_G400              "roms/video/matrox/mgaglide/897-21.bin"
+/* MGA-Glide local (GLOS D38): Matrox's PCI G200 BIOS 899-33, from the same
+   package (its PCI data structure names device 0520h). */
+#define ROM_G200_PCI          "roms/video/matrox/mgaglide/899-33.bin"
 /* MGA-Glide local: Matrox's G450 BIOS 935-20 (a 34 KB image; the flasher
  * module appended to the file lies past the 64 KB window's image end). */
 #define ROM_G450              "roms/video/matrox/mgaglide/935-20.bin"
@@ -7135,7 +7138,7 @@ mystique_pci_read(UNUSED(int func), int addr, UNUSED(int len), void *priv)
                 if (mystique->type >= MGA_G400)
                     ret = 0x25;
                 else if (mystique->type == MGA_G200)
-                    ret = 0x21;
+                    ret = mystique->is_agp ? 0x21 : 0x20;  /* MGA-Glide local: 0520h is the PCI G200 */
                 else if (mystique->type == MGA_G100)
                     ret = 0x01;
                 else
@@ -7595,6 +7598,8 @@ mystique_init(const device_t *info)
         romfn = ROM_G450;
     else if (mystique->type == MGA_G400)
         romfn = ROM_G400;
+    else if (mystique->type == MGA_G200 && !mystique->is_agp && rom_present(ROM_G200_PCI))
+        romfn = ROM_G200_PCI;               /* MGA-Glide local: the PCI card's own BIOS */
     else if (mystique->type == MGA_G200 && rom_present(ROM_G200) &&
              !(getenv("MGAGLIDE_G200_BIOS") && !strcmp(getenv("MGAGLIDE_G200_BIOS"), "g100")))
         romfn = ROM_G200;
@@ -7824,6 +7829,12 @@ matrox_g100_available(void)
     return rom_present(ROM_G100);
 }
 
+static int
+matrox_g200_pci_available(void)
+{
+    return rom_present(ROM_G200_PCI);
+}
