+/* MGA-Glide local patch 0117: XCURCOLn holds R, G, B at indices n, n+1,
+ * n+2, kept in bytes 0-2 of cursor.col[]; the screen's pixels are 0xRRGGBB.
+ * The colours are 24-bit values of their own (the specifications' XCURCOL),
+ * shown as they are in every mode: the XGA mode passed them through the
+ * palette, which at 16 bits a pixel turned them into other colours. */
+static uint32_t
+mystique_cursor_rgb(uint32_t c)
+{
+    return ((c & 0xff) << 16) | (c & 0xff00) | ((c >> 16) & 0xff);
+}
