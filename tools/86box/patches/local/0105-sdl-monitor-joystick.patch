diff --git a/src/qt/sdl_joystick.c b/src/qt/sdl_joystick.c
index fe8173b..8ce9929 100644
--- a/src/qt/sdl_joystick.c
+++ b/src/qt/sdl_joystick.c
@@ -54,6 +54,39 @@ joystick_state_t      joystick_state[GAMEPORT_MAX][MAX_JOYSTICKS];
 plat_joystick_state_t plat_joystick_state[MAX_PLAT_JOYSTICKS];
 static SDL_Joystick  *sdl_joy[MAX_PLAT_JOYSTICKS];
 
+/* MGA-Glide local patch: with BOX86_VJOY=1, one virtual joystick (4 axes,
+ * 4 buttons) follows any real ones, for a harness with no joystick; the SDL
+ * monitor's "joy" command sets its state (joystick_virtual_index()). */
+static int vjoy = -1;
+
+int
+joystick_virtual_index(void)
+{
+    return vjoy;
+}
+
+static void
+vjoy_add(void)
+{
+    const char *e = getenv("BOX86_VJOY");
+    plat_joystick_state_t *p;
+
+    if (!e || !*e || !strcmp(e, "0") || joysticks_present >= MAX_PLAT_JOYSTICKS)
+        return;
+    vjoy = joysticks_present++;
+    p    = &plat_joystick_state[vjoy];
+    memset(p, 0, sizeof(*p));
+    strcpy(p->name, "Monitor joystick");
+    p->nr_axes    = 4;
+    p->nr_buttons = 4;
+    for (int i = 0; i < 4; i++) {
+        snprintf(p->axis[i].name, sizeof(p->axis[i].name), "Axis %i", i);
+        p->axis[i].id = i;
+        snprintf(p->button[i].name, sizeof(p->button[i].name), "Button %i", i);
+        p->button[i].id = i;
+    }
+}
+
 #ifndef M_PI
 #    define M_PI 3.14159265358979323846
 #endif
