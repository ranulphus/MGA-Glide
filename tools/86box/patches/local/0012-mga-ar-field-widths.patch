+/* MGA-Glide local: AR0, AR2, AR4, AR5 and AR6 are 18 bits signed up to the
+ * G200 and 22 on the G400 (AR1 and AR3: 24), per the chips' specifications,
+ * and the trapezoid walk keeps its error terms in them, so they wrap there
+ * (a G200eR2 does: MGA-Glide docs/loop-c-results.md). Only TRAP and
+ * TEXTURE_TRAP are modelled; blits, lines and ILOAD keep the full values.
+ * Where the edges cross (right before left), the chip draws nothing. */
+static int32_t
+mga_ar_wrap(const mystique_t *mystique, int reg, int64_t v)
+{
+    int      bits = (reg == 1 || reg == 3) ? 24 : (mystique->type >= MGA_G400 ? 22 : 18);
+    uint32_t mask = (1u << bits) - 1;
+    uint32_t u    = (uint32_t) v & mask;
+
+    return (int32_t) ((u & (1u << (bits - 1))) ? (u | ~mask) : u);
+}
+
+static void
+mga_trap_ar_fields(mystique_t *mystique)
+{
+    static const int regs[6] = { 0, 1, 2, 4, 5, 6 };
+
+    for (int i = 0; i < 6; i++)
+        mystique->dwgreg.ar[regs[i]] = (uint32_t) mga_ar_wrap(mystique, regs[i], (int32_t) mystique->dwgreg.ar[regs[i]]);
+}
