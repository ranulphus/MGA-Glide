+/* MGA-Glide local patch: a LUT entry from a TLUT load (MACCESS.tlutload).
+ * The G400 family takes none by the G200's recipe: on bench-g400 every
+ * sample of a TW8 texture came out black (DOS-GL's G4EXP E5 under
+ * DGL_TLUT=1), and the HAL expands paletted textures there. What would load
+ * a G400's LUT is not known. */
+static void
+tlut_load(mystique_t *mystique, int i, uint16_t src, int first)
+{
+    if (mystique->type >= MGA_G400) {
+        if (first)
+            mga_hazard(HZ_TLUT, "a TLUT load on a G400: a real one loads nothing, and paletted texels draw black");
+        return;
+    }
+    mystique->lut[i & 0xff].r = (src >> 11) << 3;
+    mystique->lut[i & 0xff].g = ((src >> 5) & 0x3f) << 2;
+    mystique->lut[i & 0xff].b = (src & 0x1f) << 3;
+}
