+/* An AGP fetch (PRIMEND's or SECEND's bit 1) from from to to: a real G400's
+ * AGP reads don't snoop the CPU's caches, so what the CPU left in them
+ * isn't seen (bench-g400, WARPTRI noflush: nothing drawn). Write-back
+ * memory is the hazard; the HAL's rings are write-combining. */
+static void
+agp_check(const char *chan, uint32_t from, uint32_t to)
+{
+    const int a = mtrr_type(from & ~3u), b = mtrr_type((to & ~3u) - 4);
+    if (a == 6 || b == 6)
+        mga_hazard(HZ_AGP, "%s fetches %08x-%08x by AGP from write-back memory: a real G400 doesn't snoop the CPU's caches",
+                   chan, from & ~3u, to & ~3u);
+}
+
+/* MGA-Glide local patch (silicon hazards): host writes, checked in the
+ * order the engine takes them (the bus FIFO, the DMA lists).
+ * - The WARPs: this model finishes each triangle at once; a real G400 is
+ *   still setting some up when STATUS reads idle, and on bench-g400 the host
+ *   overtook them twice over:
+ *   - a new clip (CXBNDRY, YTOP, YBOT) cut the second WARP's triangle;
+ *   - a draw the host started with other state reached them: the clip
+ *     barrier's zero-length draws with an untextured DWGCTL and lightmap
+ *     copies (DSTORG, PITCH, MACCESS, DWGCTL) spoiled GLQuake's textured
+ *     triangles, and GLOS's HAL drew its own after a program's.
+ *   Linux's DRM does the same as the fixes: two DWGSYNC writes before its
+ *   clears and blits, and before a clip two zero-length draws with the
+ *   context's own DWGCTL. State written between vertex runs for the next
+ *   triangles is no hazard (the DRM does that all the time).
+ *   So with triangles in flight (set up since the last DWGSYNC write,
+ *   host-started draw or soft reset), a change of the clip, or a draw
+ *   started with DWGCTL, DSTORG, PITCH or MACCESS other than the last WARP
+ *   triangle's, is reported. Rewriting the clip the host last wrote is no
+ *   change.
+ * - OPMODE into blit mode while the WARPs work: GLQuake's lightmaps by ILOAD
+ *   went wrong in rows (the mechanism is not known).
+ * - TEXWIDTH/TEXHEIGHT whose rfw doesn't fit the size: the CPU setup's
+ *   8 - log2(size) (with tw = log2) or Mesa's 2 - log2 (with tw = log2 + 11)
+ *   for the WARP. The specification's 8 - log2 - k for prescaled q displaced
+ *   texels in perspective on the card; this model ignores rfw.
+ * - SECEND's AGP bit: agp_check. */
+static const uint16_t warp_hz_clip[5]           = { REG_CXBNDRY, REG_CXLEFT, REG_CXRIGHT, REG_YTOP, REG_YBOT };
+static const char *const warp_hz_clip_names[5]  = { "CXBNDRY", "CXLEFT", "CXRIGHT", "YTOP", "YBOT" };
+static const char *const warp_hz_state_names[4] = { "DWGCTL", "DSTORG", "PITCH", "MACCESS" };
+
+/* The state a WARP triangle or a host-started draw is drawn with. */
+static void
+warp_state(const mystique_t *mystique, uint32_t st[4])
+{
+    st[0] = mystique->dwgreg.dwgctrl;
+    st[1] = mystique->dwgreg.dstorg;
+    st[2] = mystique->dwgreg.pitch;
+    st[3] = mystique->maccess;
+}
+
+static void
+hazard_check(mystique_t *mystique, uint32_t addr, uint32_t val, int bytes)
+{
+    const int      exec = MGA_EXEC_ADDR(mystique, addr);
+    const uint32_t a    = (exec ? (addr & ~0x100) : addr) & 0x3fff;
+    const uint32_t r    = a & 0x3ffc;
+
+    if (mystique->type < MGA_G400 || mystique->warp.in_tri)
+        return;
+    if (r == REG_DWGSYNC)
+        mystique->warp.inflight = 0;
+    else if (a == REG_OPMODE) {
+        if (mystique->warp.inflight && ((val >> 2) & 3) == 1 && mystique->dwgreg.dmamod != 1)
+            mga_hazard(HZ_WARP_OPMODE, "OPMODE into blit mode with %d WARP triangles in flight: on a real G400 that spoils them",
+                       mystique->warp.inflight);
+    } else if ((r == REG_TEXWIDTH || r == REG_TEXHEIGHT) && bytes == 4 && val) {
+        const uint32_t tw = val & 63, rfw = (val >> 9) & 63, mask = (val >> 18) & 0x7ff;
+        uint32_t       lg = 0;
+        while (lg < 11 && (1u << lg) < mask + 1)
+            lg++;
+        if ((1u << lg) == mask + 1 && !(tw == lg && rfw == ((8 - lg) & 63)) && !(tw == lg + 11 && rfw == ((2 - lg) & 63)))
+            mga_hazard(HZ_RFW, "%s %08x: rfw %u for a %u-texel map (tw %u); a real G400 wants %u (or %u with tw %u)",
+                       r == REG_TEXWIDTH ? "TEXWIDTH" : "TEXHEIGHT", val, rfw, mask + 1, tw, (8 - lg) & 63, (2 - lg) & 63, lg + 11);
+    } else if (r == REG_SECEND && bytes == 4 && (val & 2))
+        agp_check("SECEND", mystique->dma.secaddress, val);
+    else {
+        for (int i = 0; i < 5; i++) {
+            if (r != warp_hz_clip[i])
+                continue;
+            const int      sh  = (int) (a & 3) * 8;
+            const uint32_t old = mystique->warp.host[i];
+            const uint32_t nv  = bytes == 4 ? val : ((old & ~(0xffu << sh)) | ((val & 0xff) << sh));
+            if (mystique->warp.inflight && (mystique->warp.host_known & (1u << i)) && nv != old)
+                mga_hazard(HZ_WARP_REG, "%s %08x -> %08x with %d WARP triangles in flight: on a real G400 the clip reaches them "
+                           "(the DRM's barrier first: two zero-length draws with their DWGCTL)",
+                           warp_hz_clip_names[i], old, nv, mystique->warp.inflight);
+            mystique->warp.host[i] = nv;
+            mystique->warp.host_known |= 1u << i;
+            break;
+        }
+    }
+    if (exec && (bytes == 4 || (a & 3) == 3)) {
+        if (mystique->warp.inflight) {
+            uint32_t st[4];
+            char     d[128] = "";
+            warp_state(mystique, st);
+            if (bytes == 4) {   /* (this write's own value, when it is one of them) */
+                if (r == REG_DWGCTL)
+                    st[0] = val;
+                else if (r == REG_DSTORG)
+                    st[1] = val;
+                else if (r == REG_PITCH)
+                    st[2] = val & 0xffff;
+                else if (r == REG_MACCESS)
+                    st[3] = val;
+            }
+            for (int i = 0; i < 4; i++)
+                if (st[i] != mystique->warp.tri_state[i])
+                    snprintf(d + strlen(d), sizeof(d) - strlen(d), " %s %08x (theirs %08x)", warp_hz_state_names[i],
+                             st[i], mystique->warp.tri_state[i]);
+            if (d[0])
+                mga_hazard(HZ_WARP_REG, "a draw started with%s and %d WARP triangles in flight: on a real G400 it reaches "
+                           "them (DWGSYNC first)", d, mystique->warp.inflight);
+        }
+        mystique->warp.inflight = 0;
+    }
+}
