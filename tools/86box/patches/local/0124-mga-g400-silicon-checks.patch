+/* MGA-Glide local patch: silicon hazards. A real G400 goes wrong where this
+ * model draws right (bench-g400; MGA-Glide docs/emulated-g400.md, "Checks"):
+ * where what the chip does is not known well enough to model, the model
+ * draws as before and reports the hazard on stderr and in the 86Box log, as
+ * MGA-HAZARD lines that tools/loopa/run.py collects. Each kind's first four,
+ * then its 10th, 100th, and so on. */
+enum {
+    HZ_WARP_REG,        /* a drawing register changed under triangles the WARPs may still set up */
+    HZ_WARP_OPMODE,     /* OPMODE into blit mode while the WARPs work */
+    HZ_RFW,             /* TEXWIDTH/TEXHEIGHT rfw that doesn't fit the size */
+    HZ_AGP,             /* an AGP fetch from memory the CPU caches write-back */
+    HZ_TLUT,            /* the G200's LUT load on the G400 family */
+    HZ_KINDS
+};
+static const char *const hz_names[HZ_KINDS] = { "warp-inflight", "warp-opmode", "rfw", "agp-cached", "tlut" };
+
+static void
+mga_hazard(int kind, const char *fmt, ...)
+{
+    static unsigned n[HZ_KINDS];
+    unsigned        c = ++n[kind], p = 10;
+    char            msg[256];
+    va_list         ap;
+
+    while (p < c)
+        p *= 10;
+    if (c > 4 && c != p)
+        return;
+    va_start(ap, fmt);
+    vsnprintf(msg, sizeof(msg), fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "MGA-HAZARD: %s: #%u: %s\n", hz_names[kind], c, msg);
+    pclog("MGA-HAZARD: %s: #%u: %s\n", hz_names[kind], c, msg);
+}
