+/* MGA-Glide local patch (silicon hazards): the CPU's memory type at a
+ * physical address, from CR0.CD and its MTRRs (Intel SDM 11.11.4): 0 UC,
+ * 1 WC, 4 WT, 5 WP, 6 WB. The page tables' PCD and PWT are not looked at. */
+static int
+mtrr_type(uint32_t pa)
+{
+    int t = -1;
+
+    if ((cr0 & (1u << 30)) || !(msr.mtrr_deftype & 0x800))
+        return 0;
+    if (pa < 0x100000 && (msr.mtrr_deftype & 0x400)) {
+        uint64_t r;
+        if (pa < 0x80000)
+            r = msr.mtrr_fix64k_8000 >> ((pa >> 16) * 8);
+        else if (pa < 0xc0000)
+            r = (pa < 0xa0000 ? msr.mtrr_fix16k_8000 : msr.mtrr_fix16k_a000) >> (((pa >> 14) & 7) * 8);
+        else
+            r = msr.mtrr_fix4k[(pa - 0xc0000) >> 15] >> (((pa >> 12) & 7) * 8);
+        return (int) (r & 0xff);
+    }
+    for (int i = 0; i < 8; i++) {
+        const uint64_t m = msr.mtrr_physmask[i] & 0xffffff000ull;
+        int            ty;
+        if (!(msr.mtrr_physmask[i] & 0x800) || ((pa & m) != (msr.mtrr_physbase[i] & m)))
+            continue;
+        ty = (int) (msr.mtrr_physbase[i] & 0xff);
+        if (ty == 0)
+            return 0;
+        if (t < 0 || (t == 6 && ty == 4))
+            t = ty;
+    }
+    return t >= 0 ? t : (int) (msr.mtrr_deftype & 0xff);
+}
