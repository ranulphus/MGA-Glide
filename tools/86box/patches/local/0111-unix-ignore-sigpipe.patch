+#ifdef SIGPIPE
+    /* A host socket that SLiRP writes to after its peer has gone (an SSH
+       client that closed first) raises SIGPIPE, whose default action ends
+       the emulator. Ignore it, as QEMU does: the write fails with EPIPE and
+       SLiRP closes the connection. (Windows has no SIGPIPE.) */
+    signal(SIGPIPE, SIG_IGN);
+#endif
