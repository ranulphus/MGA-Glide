+/* MGA-Glide local patch (WP-3): G200 alpha test and blending (ALPHACTRL
+ * src[3:0] dst[7:4] aten[12] atmode[15:13] atref[23:16]). Returns 0 when
+ * the alpha test rejects the pixel. Destination alpha is 255 in 16 bpp. */
+static int
+g200_blend(mystique_t *mystique, int x, int *r, int *g, int *b, int a, int dest32)
+{
+    const uint32_t ac  = mystique->dwgreg.alphactrl;
+    const int      sfn = ac & 0xf, dfn = (ac >> 4) & 0xf;
+    svga_t        *svga = &mystique->svga;
+    int            sc[3], dc[3], da = 255, i;
+
+    if (ac & ALPHACTRL_ATEN) {
+        int ref = (ac >> 16) & 0xff, pass;
+        switch ((ac >> 13) & 7) {
+            case 2: pass = a == ref; break;
+            case 3: pass = a != ref; break;
+            case 4: pass = a < ref; break;
+            case 5: pass = a <= ref; break;
+            case 6: pass = a > ref; break;
+            case 7: pass = a >= ref; break;
+            default: pass = 1; break;
+        }
+        if (!pass)
+            return 0;
+    }
+    if (sfn == 1 && dfn == 0)
+        return 1;
+    if (dest32) {
+        uint32_t d = ((uint32_t *) svga->vram)[(mystique->dwgreg.ydst_lin + x) & mystique->vram_mask_l];
+        dc[0] = (d >> 16) & 0xff; dc[1] = (d >> 8) & 0xff; dc[2] = d & 0xff; da = d >> 24;
+    } else {
+        uint16_t d = ((uint16_t *) svga->vram)[(mystique->dwgreg.ydst_lin + x) & mystique->vram_mask_w];
+        dc[0] = ((d >> 11) & 0x1f) << 3; dc[0] |= dc[0] >> 5;
+        dc[1] = ((d >> 5) & 0x3f) << 2;  dc[1] |= dc[1] >> 6;
+        dc[2] = (d & 0x1f) << 3;         dc[2] |= dc[2] >> 5;
+    }
+    sc[0] = *r; sc[1] = *g; sc[2] = *b;
+    for (i = 0; i < 3; i++) {
+        int fs, fd, v;
+        switch (sfn) {
+            case 0: fs = 0; break;
+            case 1: fs = 255; break;
+            case 2: fs = dc[i]; break;
+            case 3: fs = 255 - dc[i]; break;
+            case 4: fs = a; break;
+            case 5: fs = 255 - a; break;
+            case 6: fs = da; break;
+            case 7: fs = 255 - da; break;
+            case 8: fs = a < 255 - da ? a : 255 - da; break;
+            default: fs = 255; break;
+        }
+        switch (dfn) {
+            case 0: fd = 0; break;
+            case 1: fd = 255; break;
+            case 2: fd = sc[i]; break;
+            case 3: fd = 255 - sc[i]; break;
+            case 4: fd = a; break;
+            case 5: fd = 255 - a; break;
+            case 6: fd = da; break;
+            case 7: fd = 255 - da; break;
+            default: fd = 0; break;
+        }
+        v = (sc[i] * fs + dc[i] * fd + 127) / 255;
+        sc[i] = v > 255 ? 255 : v;
+    }
+    *r = sc[0]; *g = sc[1]; *b = sc[2];
+    return 1;
+}
