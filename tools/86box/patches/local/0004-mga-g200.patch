+/* MGA-Glide local patch (WP-3): effective origins. On the G200, DSTORG
+ * (bytes) moves the colour buffer; ZORG is absolute, so depth addresses
+ * leave DSTORG out. */
+static void
+g200_origin_update(mystique_t *mystique)
+{
+    int bpp;
+    switch (mystique->maccess & MACCESS_PWIDTH_MASK) {
+        case MACCESS_PWIDTH_16: bpp = 2; break;
+        case MACCESS_PWIDTH_24: bpp = 3; break;
+        case MACCESS_PWIDTH_32: bpp = 4; break;
+        default: bpp = 1; break;
+    }
+    mystique->dwgreg.dstorg_px = (mystique->type >= MGA_G200) ? mystique->dwgreg.dstorg / bpp : 0;
+    mystique->dwgreg.ydstorg   = mystique->dwgreg.ydstorg_reg + mystique->dwgreg.dstorg_px;
+    mystique->dwgreg.ytop      = mystique->dwgreg.ytop_reg + mystique->dwgreg.dstorg_px;
+    mystique->dwgreg.ybot      = mystique->dwgreg.ybot_reg + mystique->dwgreg.dstorg_px;
+    mystique->dwgreg.z_base    = (mystique->dwgreg.ydstorg - mystique->dwgreg.dstorg_px) * ((mystique->maccess & MACCESS_ZWIDTH) ? 4 : 2) + mystique->dwgreg.zorg;
+}
