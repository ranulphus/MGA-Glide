+static int
+g200_read_level(mystique_t *mystique, int level, int filt, int *tex_r, int *tex_g, int *tex_b, int *atransp, int *tex_a)
+{
+    const uint32_t org = mystique->dwgreg.texorg, tw = mystique->dwgreg.texwidth, th = mystique->dwgreg.texheight;
+    const uint32_t tc = mystique->dwgreg.texctl, tf = mystique->dwgreg.texfilter;
+    int            ret;
+    if (level > 0) {
+        int w = (int) ((tw & TEXWIDTH_TWMASK_MASK) >> TEXWIDTH_TWMASK_SHIFT) + 1;
+        int h = (int) ((th & TEXHEIGHT_THMASK_MASK) >> TEXHEIGHT_THMASK_SHIFT) + 1;
+        int lw = (int) (tw & TEXWIDTH_TW_MASK) - level, lh = (int) (th & TEXHEIGHT_TH_MASK) - level;
+        w >>= level; h >>= level;
+        if (w < 1) w = 1;
+        if (h < 1) h = 1;
+        if (lw < 0) lw = 0;
+        if (lh < 0) lh = 0;
+        mystique->dwgreg.texorg    = mystique->dwgreg.texorgn[level - 1];
+        mystique->dwgreg.texwidth  = (tw & ~(TEXWIDTH_TW_MASK | TEXWIDTH_TWMASK_MASK)) | (uint32_t) lw | ((uint32_t) (w - 1) << TEXWIDTH_TWMASK_SHIFT);
+        mystique->dwgreg.texheight = (th & ~(TEXHEIGHT_TH_MASK | TEXHEIGHT_THMASK_MASK)) | (uint32_t) lh | ((uint32_t) (h - 1) << TEXHEIGHT_THMASK_SHIFT);
+        if (tc & TEXCTL_TPITCHLIN) {
+            int pitch = (int) ((tc & TEXCTL_TPITCHEXT_MASK) >> 9);
+            if (!pitch)
+                pitch = 2048;
+            pitch >>= level;
+            if (pitch < 1)
+                pitch = 1;
+            mystique->dwgreg.texctl = (tc & ~TEXCTL_TPITCHEXT_MASK) | ((uint32_t) (pitch & 0x7ff) << 9);
