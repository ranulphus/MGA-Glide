+/* MGA-Glide local patch (WP-3): G200 mipmapping. TEXORG1..4 hold levels
+ * 1..4, TEXFILTER mapnb[31:29] the last level and minfilter[3:0] the mode
+ * (8 nearest level, point; 9 nearest level, bilinear; 0xA two levels,
+ * point; 0xC two levels, bilinear). The level comes from the per-pixel
+ * gradients of the texture coordinates, lambda = 0.5 log2 of the larger
+ * squared gradient, as the Voodoo computes it; G200 silicon is to be
+ * checked on the bench (PRD milestone S / M5). Each level halves the
+ * width, height and pitch. */
+static void
+g200_uv(mystique_t *mystique, int32_t S, int32_t T, int32_t Q, double *u, double *v)
+{
+    const int s_shift = 20 - (mystique->dwgreg.texwidth & TEXWIDTH_TW_MASK);
+    const int t_shift = 20 - (mystique->dwgreg.texheight & TEXHEIGHT_TH_MASK);
+    if (mystique->dwgreg.texctl & TEXCTL_NPCEN) {
+        *u = S / (double) (1 << s_shift);
+        *v = T / (double) (1 << t_shift);
+    } else {
+        double q = FixedToFloat(Q);
+        if (q == 0.0)
+            q = 1e-9;
+        *u = (double) (S >> s_shift) / q;
+        *v = (double) (T >> t_shift) / q;
+    }
+}
