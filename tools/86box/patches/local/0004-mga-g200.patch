+static int
+texture_read(mystique_t *mystique, int *tex_r, int *tex_g, int *tex_b, int *atransp, int *tex_a)
+{
+    const uint32_t tf    = mystique->dwgreg.texfilter;
+    const int      minf  = tf & 0xf, magf = (tf >> 4) & 0xf, last = (tf >> 29) & 7;
+    double         u, v, ux, vx, uy, vy, gx, gy, g, lambda;
+    int            level, filt, two, ret;
+
+    if (mystique->type < MGA_G200 || minf < 8 || !last)
+        return texture_read_level(mystique, tex_r, tex_g, tex_b, atransp, tex_a);
+    g200_uv(mystique, (int32_t) mystique->dwgreg.tmr[6], (int32_t) mystique->dwgreg.tmr[7], (int32_t) mystique->dwgreg.tmr[8], &u, &v);
+    g200_uv(mystique, (int32_t) (mystique->dwgreg.tmr[6] + mystique->dwgreg.tmr[0]), (int32_t) (mystique->dwgreg.tmr[7] + mystique->dwgreg.tmr[2]),
+            (int32_t) (mystique->dwgreg.tmr[8] + mystique->dwgreg.tmr[4]), &ux, &vx);
+    g200_uv(mystique, (int32_t) (mystique->dwgreg.tmr[6] + mystique->dwgreg.tmr[1]), (int32_t) (mystique->dwgreg.tmr[7] + mystique->dwgreg.tmr[3]),
+            (int32_t) (mystique->dwgreg.tmr[8] + mystique->dwgreg.tmr[5]), &uy, &vy);
+    gx = (ux - u) * (ux - u) + (vx - v) * (vx - v);
+    gy = (uy - u) * (uy - u) + (vy - v) * (vy - v);
+    g  = gx > gy ? gx : gy;
+    lambda = g > 0 ? 0.5 * log2(g) : -64.0;
+    if (lambda <= 0.0)
+        return g200_read_level(mystique, 0, magf == 2 ? 2 : 0, tex_r, tex_g, tex_b, atransp, tex_a);
+    filt  = (minf == 0x9 || minf == 0xc) ? 2 : 0;
+    two   = (minf == 0xa || minf == 0xc);
+    level = (int) floor(lambda);
+    if (level >= last) {
+        level = last;
+        two   = 0;
+    }
+    ret = g200_read_level(mystique, level, filt, tex_r, tex_g, tex_b, atransp, tex_a);
+    if (two) {
+        int r2, g2, b2, a2 = 255, at2 = 0;
+        double f = lambda - level;
+        g200_read_level(mystique, level + 1, filt, &r2, &g2, &b2, &at2, &a2);
+        *tex_r = (int) (*tex_r + (r2 - *tex_r) * f);
+        *tex_g = (int) (*tex_g + (g2 - *tex_g) * f);
+        *tex_b = (int) (*tex_b + (b2 - *tex_b) * f);
+        *tex_a = (int) (*tex_a + (a2 - *tex_a) * f);
+    }
+    return ret;
+}
