@ECHO OFF
REM Bench poller: fetch and run jobs published by tools/bench/run.py.
REM Needs mTCP (DHCP, HTGET) and HX_URL set, e.g.
REM   SET HX_URL=http://192.168.1.10:8000/bench-g100
SET PATH=%PATH%;C:\HX;C:\MTCP
SERSAY HX-BOOT loop=B
DHCP > NUL
:POLL
HTGET -o C:\HX\LATEST.TXT %HX_URL%/LATEST.TXT > NUL
IF ERRORLEVEL 1 GOTO WAIT
FC /B C:\HX\LATEST.TXT C:\HX\LAST.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO WAIT
COPY C:\HX\LATEST.TXT C:\HX\LAST.TXT > NUL
HTGET -o C:\HX\FETCH.BAT %HX_URL%/FETCH.BAT > NUL
CALL C:\HX\FETCH.BAT
CALL C:\HX\JOB\RUN.BAT
SERSAY HX-JOB-END
REBOOT
:WAIT
SERSAY HX-IDLE
WAITSEC 10
GOTO POLL
